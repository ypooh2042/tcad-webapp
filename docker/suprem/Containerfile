# SUPREM4GS 실행 샌드박스.
#
# ─────────────────────────────────────────────────────────────────────────
#  이 컨테이너는 "신뢰할 수 없는 코드를 돌리는 곳"이 아니라
#  "적대적인 코드가 반드시 돌아온다고 가정하는 곳"이다.
#
#  SUPREM4GS 인터프리터는 인식하지 못한 첫 단어를 /bin/bash 로 넘긴다.
#  즉 사용자가 제출하는 .in 파일은 그 자체로 임의 셸 스크립트다.
#  실측 확인: .in 에 `id` 한 줄만 넣고 돌리면 호스트 유저의 uid/gid 와 소속
#  그룹(sudo 포함)이 그대로 출력된다.
#
#  따라서 아래 설정은 성능이나 편의를 위해 완화해서는 안 된다.
#  실행 측 제약(--network none, --cap-drop ALL 등)은 app/runner/sandbox.py 참조.
# ─────────────────────────────────────────────────────────────────────────

FROM debian:bookworm-slim

# suprem 은 x86-64 동적 링크 실행파일이고 의존성은 libc.so.6 / libm.so.6 뿐이다
# (ldd 로 확인). 베이스 이미지에 이미 있으므로 추가 패키지 설치가 필요 없다.
# 패키지를 안 깔면 공격 표면도 그만큼 줄어든다.

RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin suprem

# 바이너리와 물성 데이터는 root 소유 + 쓰기 불가.
# 실행 유저(suprem)가 자기 실행 환경을 고쳐 쓰지 못하게 한다.
COPY SUPREM4GS/suprem   /opt/suprem4gs/suprem
COPY SUPREM4GS/data/    /opt/suprem4gs/data/

RUN chown -R root:root /opt/suprem4gs \
 && chmod 0555 /opt/suprem4gs/suprem \
 && chmod -R a-w /opt/suprem4gs

# suprem4gs 래퍼 스크립트는 SUPREM4_HOME="$(pwd)" 로 잡기 때문에 실행 위치에
# 종속적이고, 결과 파일도 cwd 에 떨어져 동시 실행 시 서로 덮어쓴다.
# 래퍼를 쓰지 않고 아래 4개 변수를 절대경로로 직접 지정해 그 문제를 없앤다.
# (SUPREM4GS 폴더 밖에서 실행해 정상 동작하는 것을 실측 확인)
#
# SUP4MANDIR 이 가리키는 help/ 는 이 배포판에 존재하지 않는다. `man` 커맨드가
# 동작하지 않을 뿐 시뮬레이션에는 영향이 없다(실행으로 확인). 문서 기능은
# 매뉴얼 PDF 에서 따로 만든다.
ENV SUP4KEYFILE=/opt/suprem4gs/data/suprem.uk \
    SUP4MODELRC=/opt/suprem4gs/data/modelrc \
    SUP4IMPDATA=/opt/suprem4gs/data/sup4gs.imp \
    SUP4MANDIR=/opt/suprem4gs/help

# 격자가 조금만 커지면 `diffuse` 가 세그폴트로 죽는 것을 막는다.
#
# 시뮬레이터의 희소행렬 작업공간은 realloc 으로 두 배씩 커지는 자체 풀인데,
# min_ia_fill 이 그 realloc 뒤에도 **호출 전에 구한 포인터를 계속 쓴다**
# (crash 직전 세 명령어: call new_storage → freelist 는 다시 읽고 → %rbx 는
# 옛 주소 그대로 역참조). 1993년 malloc 은 큰 블록도 힙에서 잡아 대개 제자리
# 확장이라 이 버그가 잠들어 있었지만, 현대 glibc 는 128KB 를 넘는 할당을
# mmap 으로 돌리고 늘릴 때 mremap 으로 주소를 옮겨 버그를 깨운다.
#
# 임계값을 올려 큰 할당도 힙에 두면 제자리 확장이 되어 옛 포인터가 유효한 채로
# 남는다. **버그를 고치는 것이 아니라 발동 조건을 피하는 것이다** — 풀이
# 아주 커지면 결국 옮겨질 수 있으므로 격자 크기 제약이 사라지지는 않는다.
#
# 실측: 이것만으로 죽던 격자 3종이 모두 통과했고, 양쪽에서 모두 도는 격자의
# 결과 `.str` 은 바이트 단위로 동일했다(값을 바꾸지 않는다는 뜻).
ENV MALLOC_MMAP_THRESHOLD_=1073741824

USER suprem

# 잡별 스크래치 디렉토리가 여기에 rw 로 마운트된다. 컨테이너 안에서 쓰기가
# 허용되는 유일한 경로다.
WORKDIR /work

ENTRYPOINT ["/opt/suprem4gs/suprem"]
