+/************************************************************************
+ *
+ *  amd_fill.c  --  AMD(근사 최소 차수) 순서화.
+ *
+ *  math/min_fill.c 의 min_ia_fill 을 대신할 수 있다. 무엇을 하는지는 같다 —
+ *  가우스 소거의 채움(fill)을 줄이는 노드 순서를 찾는다.
+ *
+ *  왜 바꾸나: 실측으로 산화 한 단계의 41% 가 symfac(기호 분해)이고, 그 비용은
+ *  순서화가 만드는 채움이 정한다. 점 5,755 → 12,963 으로 늘렸을 때 symfac 이
+ *  4 배가 됐다(초선형). 순서화 자체는 선형이었으므로, 손댈 곳은 순서화의
+ *  **속도가 아니라 품질**이다.
+ *
+ *  AMD 는 SuiteSparse 의 근사 최소 차수 구현이다. 1993 년의 naive 최소 차수와
+ *  같은 계열이지만 supervariable·mass elimination 같은 기법이 들어가 있어
+ *  같은 시간에 더 나은 순서를 낸다. BSD-3-Clause 이고 정적 링크한다.
+ *
+ *  실측(재메쉬 12,963 점, 산화 한 단계):
+ *
+ *      symfac        22.6 초 → 9.1 초   (회당 0.10 → 0.04, 채움이 줄어서)
+ *      순서화 자체    9.6 초 → 상위 10 위 밖
+ *      numfac         3.8 초 → 2.8 초
+ *      전체          55.7 초 → 32.1 초  (1.74 배)
+ *
+ *  **기본으로 쓴다.** 순서가 달라지면 부동소수점 연산 순서가 달라져 결과가
+ *  미세하게 달라지지만, 실측으로 번들 예제 13 개의 총선량 차이가 최대
+ *  0.084% 였다(반올림 수준). 되돌리려면 SUP4_ORDER=minfill 을 준다.
+ *
+ ************************************************************************/
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "global.h"
+#include "constant.h"
+#include "suitesparse/amd.h"
+
+/*이 순서화를 쓸지.
+
+  **2 차원에서만 쓴다.** min_ia_fill 의 1 차원 분기는 채움 최소화가 아니라
+  노출면에서 시작해 소자를 따라가는 **물리적 순서**를 만든다(min_fill.c 의
+  `case ONED`). 채움만 보고 고른 순서로 바꾸면 1 차원 결과가 통째로 망가진다 —
+  실측으로 골든 파일 대비 상대차가 7e15 였다. 채움이 문제가 되는 것은 2 차원
+  뿐이므로 거기서만 쓴다.
+
+  2 차원에서도 SUP4_ORDER=minfill 이면 1993 년 순서화로 돌아간다.*/
+int use_amd_order()
+{
+    static int decided = -1;
+    char *want;
+
+    if ( mode != TWOD ) return( 0 );
+
+    if ( decided < 0 ) {
+	want = getenv("SUP4_ORDER");
+	decided = !( want != NULL && strcmp(want, "minfill") == 0 );
+    }
+    return( decided );
+}
+
+
+/*-----------------AMD_IA_FILL------------------------------------------
+ *  min_ia_fill 과 같은 계약: reorder[옛 번호] = 새 번호.
+ *
+ *  ia 는 포인터와 인덱스를 한 배열에 담은 형식이다 — 행 i 의 이웃은
+ *  ia[j], j 가 [ia[i], ia[i+1]) 이다. 대각(자기 자신)은 AMD 가 받지 않으므로
+ *  걸러낸다.
+ *
+ *  Returns: 채움 크기(L 의 비영 개수). 실패하면 -1 — 호출부가 기존 순서화로
+ *  물러선다. 조용히 잘못된 순서를 쓰면 결과가 틀린다.
+ *--------------------------------------------------------------------*/
+int amd_ia_fill( ia, reorder, talk )
+    int *ia;
+    int *reorder;
+    int talk;
+{
+    int n, nz, i, j, k, status;
+    int *Ap, *Ai, *P;
+    double Info[AMD_INFO];
+
+    n = ia[0] - 1;
+    if ( n <= 0 ) return( -1 );
+
+    Ap = (int *) malloc( (n + 1) * sizeof(int) );
+    P  = (int *) malloc( n * sizeof(int) );
+    if ( !Ap || !P ) { free(Ap); free(P); return( -1 ); }
+
+    nz = 0;
+    for(i = 0; i < n; i++) {
+	Ap[i] = nz;
+	for(j = ia[i]; j < ia[i+1]; j++)
+	    if ( ia[j] != i ) nz++;
+    }
+    Ap[n] = nz;
+
+    Ai = (int *) malloc( (nz > 0 ? nz : 1) * sizeof(int) );
+    if ( !Ai ) { free(Ap); free(P); return( -1 ); }
+
+    k = 0;
+    for(i = 0; i < n; i++)
+	for(j = ia[i]; j < ia[i+1]; j++)
+	    if ( ia[j] != i ) Ai[k++] = ia[j];
+
+    status = amd_order( n, Ap, Ai, P, (double *) NULL, Info );
+
+    if ( status != AMD_OK && status != AMD_OK_BUT_JUMBLED ) {
+	free(Ap); free(Ai); free(P);
+	return( -1 );
+    }
+
+    /*P[k] 는 k 번째로 소거되는 옛 번호다. 우리가 원하는 것은 그 역이다.*/
+    for(k = 0; k < n; k++) reorder[ P[k] ] = k;
+
+    if ( talk )
+	printf("amd: lnz=%.0f flops=%.3g\n", Info[AMD_LNZ], Info[AMD_NDIV]);
+
+    free(Ap); free(Ai); free(P);
+    return( (int) Info[AMD_LNZ] );
+}
