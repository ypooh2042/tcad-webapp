--- a/src/refine/etch_elem.c
+++ b/src/refine/etch_elem.c
@@ -0,0 +1,553 @@
+/*----------------------------------------------------------------------
+ *  etch_elem.c  --  요소 기반(cut-cell) 식각.
+ *
+ *  기존 etch() 는 경계선 클리핑(B-rep)이다. 식각 다각형의 변과 영역 경계의
+ *  변이 어디서 만나는지를 edg_crs() 로 하나씩 찾아 조각을 잇는데, 판단이
+ *  전부 변 단위 국소 판단이라 짝을 못 찾으면 고리가 안 닫히고 전역 위상이
+ *  깨진다. 식각선이 재료 경계와 거의 나란해지면(실측: 교차각 2.1 도) 겹친
+ *  변에 교차점이 정의되지 않아 그 일이 실제로 일어난다.
+ *
+ *  여기서는 다각형을 잇지 않는다. 삼각형 하나를 선으로 자르는 것은 교점이
+ *  최대 2 개이고 결과가 1~3 개 삼각형인 완전히 국소적인 연산이라, 전역
+ *  조각 잇기가 아예 없다.
+ *
+ *  절단 기하는 새로 짜지 않았다. sp_edge() 가 이미
+ *    - 영역 계면 변에서는 반대편 물질 노드까지 함께 갱신하고
+ *    - 새 노드의 물성값을 변을 따라 선형 보간하며
+ *    - new_edg_tri() 로 그 변을 쓰는 삼각형 전부를 정합하게 쪼갠다
+ *  이 파일은 "어디를 자르고 무엇을 지울지"만 정한다.
+ *
+ *  절단점이 기존 꼭짓점에 아주 가까우면 자르지 않고 **그 꼭짓점의 분류를
+ *  바꾼다**. sp_edge 에도 비슷한 스냅이 있지만 그쪽은 점의 좌표를 옮기는
+ *  방식이라(move_edge) 그 점을 공유하는 삼각형이 뒤집힐 수 있고, 실제로
+ *  "not clock wise" 로 죽었다. 분류만 바꾸면 기하는 그대로다.
+ *
+ *  자르기와 지우기 **사이에 bd_connect() 를 한 번 돌린다.** 지우는 쪽인
+ *  rem_ele(t,TRUE) 는 neigh_fc() 로 이웃을 찾아 드러난 면을 노출 처리하는데,
+ *  갓 만든 삼각형은 nb[] 가 미정이라 이웃을 못 찾는다. 표면 플래그를 우리가
+ *  직접 유도해 보려 했지만, make_bc() 가 "양 끝점이 표면인 면"을 전부 노출로
+ *  찍기 때문에 얇은 영역을 가로지르는 내부 면까지 표면이 되어 표면선이
+ *  갈라졌다 — find_surf() 가 거기서 죽었다(백트레이스로 확인).
+ *  중간에 bd_connect 를 돌리면 그 뒤로는 코드베이스 자신의 메커니즘이
+ *  그대로 동작한다. 자르기만 한 상태는 삼각형을 쪼갠 것뿐이라 유효한
+ *  메시이므로 자기검사도 통과한다. 점 번호가 바뀌므로 분류는 다시 구한다.
+ *--------------------------------------------------------------------*/
+
+#include <stdio.h>
+#include <math.h>
+#include <stdlib.h>
+#include <global.h>
+#include <constant.h>
+#include <geom.h>
+#include <dbaccess.h>
+#include <material.h>
+#include "refine.h"
+
+/* 잘라낼 곳 한 군데 */
+struct cut_str {
+    int edge;			/* 자를 변 */
+    int pin, pout;		/* 안쪽 끝점 / 바깥쪽 끝점 */
+    double t;			/* 안쪽 끝점에서 잰 매개변수 */
+    float c[MAXDIM];		/* 자를 자리 */
+};
+
+/*-----------------IN_ETCH_POLY-----------------------------------------
+ *  점이 식각 다각형 안인가. crossing number 판정.
+ *
+ *  경계에 정확히 놓인 점은 "밖"으로 본다 — 그 점이 곧 새 식각면이 되므로
+ *  남겨야 한다.
+ *
+ *  **판정은 이 함수 하나뿐이고, 결과는 점마다 한 번만 구해 배열에 담는다.**
+ *  같은 점을 두 곳에서 다르게 판정하는 순간 B-rep 과 같은 병에 걸린다.
+ *--------------------------------------------------------------------*/
+static int in_etch_poly( x, y, px, py, n )
+float x, y;
+float *px, *py;
+int n;
+{
+    int i, j, c = 0;
+
+    if ( mode == ONED ) {
+	/*1 차원에서는 x 가 깊이다. 다각형이 아니라 구간이다.*/
+	float lo = px[0], hi = px[0];
+	for(i = 1; i < n; i++) {
+	    if ( px[i] < lo ) lo = px[i];
+	    if ( px[i] > hi ) hi = px[i];
+	}
+	return( (x > lo) && (x < hi) );
+    }
+
+    for(i = 0, j = n-1; i < n; j = i++) {
+	if ( ((py[i] > y) != (py[j] > y)) &&
+	     (x < (px[j]-px[i]) * (y-py[i]) / (py[j]-py[i]) + px[i]) )
+	    c = !c;
+    }
+    return( c );
+}
+
+
+/*-----------------SEG_CROSS--------------------------------------------
+ *  선분 a->b 와 c->d 가 만나는가. 만나면 a 에서의 매개변수 t 를 준다.
+ *
+ *  edg_crs() 와 달리 여기서는 못 만나도 아무 일이 없다 — 그냥 다음 후보를
+ *  본다. 이 함수의 실패가 전역 위상을 깨뜨릴 수 없다는 것이 이 설계의 요점.
+ *--------------------------------------------------------------------*/
+static int seg_cross( ax, ay, bx, by, cx, cy, dx, dy, t )
+double ax, ay, bx, by, cx, cy, dx, dy;
+double *t;
+{
+    double rx = bx - ax, ry = by - ay;
+    double sx = dx - cx, sy = dy - cy;
+    double den = rx * sy - ry * sx;
+    double tt, uu;
+
+    if ( den == 0.0 ) return( FALSE );		/*평행 — 다음 후보로*/
+
+    tt = ((cx - ax) * sy - (cy - ay) * sx) / den;
+    uu = ((cx - ax) * ry - (cy - ay) * rx) / den;
+
+    if ( (tt < 0.0) || (tt > 1.0) || (uu < 0.0) || (uu > 1.0) ) return( FALSE );
+
+    *t = tt;
+    return( TRUE );
+}
+
+
+/*-----------------EDGE_CUT---------------------------------------------
+ *  변 e 가 식각 경계를 가로지르는가.
+ *
+ *  가로지르면 TRUE 와 함께: 안쪽 끝점 *pin, 바깥쪽 끝점 *pout, 안쪽에서 잰
+ *  매개변수 *tout (0 이면 안쪽 끝점, 1 이면 바깥쪽 끝점), 교점 좌표 c.
+ *
+ *  다각형과 여러 번 만나면 바깥쪽에 가장 가까운 교점을 쓴다 — 덜 남기는
+ *  쪽으로 치우치게 해서 얇은 조각을 만들지 않는다.
+ *--------------------------------------------------------------------*/
+static int edge_cut( e, gone, p, nump, pin, pout, tout, c )
+int e;
+char *gone;
+float *p[MAXDIM+1];
+int nump;
+int *pin, *pout;
+double *tout;
+float c[MAXDIM];
+{
+    int j, i, a, b;
+    double t_at, best = -1.0;
+
+    a = pt_nd( nd_edg(e,0) );
+    b = pt_nd( nd_edg(e,1) );
+    if ( gone[a] == gone[b] ) return( FALSE );
+
+    if ( !gone[a] ) { i = a; a = b; b = i; }	/*a 가 안쪽이 되게*/
+
+    for(j = 0; j < nump; j++) {
+	i = (j + 1) % nump;
+	if ( seg_cross( (double)cordinate(a,0), (double)cordinate(a,1),
+			(double)cordinate(b,0), (double)cordinate(b,1),
+			(double)p[0][j], (double)p[1][j],
+			(double)p[0][i], (double)p[1][i], &t_at ) )
+	    if ( t_at > best ) best = t_at;
+    }
+    if ( best < 0.0 ) return( FALSE );
+
+    *pin = a;  *pout = b;  *tout = best;
+    c[0] = cordinate(a,0) + best * (cordinate(b,0) - cordinate(a,0));
+    c[1] = cordinate(a,1) + best * (cordinate(b,1) - cordinate(a,1));
+    return( TRUE );
+}
+
+
+/*-----------------ON_POLY----------------------------------------------
+ *  점이 식각 다각형 경계 위에 있는가. 허용오차는 skel.c 의 on_bound() 와
+ *  같은 1.0e-8 cm 를 쓴다.
+ *--------------------------------------------------------------------*/
+/*식각면 위로 볼 거리. 처음에는 skel.c 의 on_bound() 를 따라 1e-8 cm(0.1 nm)
+  로 두었는데, 그 값이 이 문제의 기하와 같은 크기라 칼날 위에 놓였다.
+
+  증착은 **법선 오프셋**이고 식각은 **수직 이동**이다. 기울기 theta 인 면에서
+  두 연산은 thick*(sec theta - 1) 만큼 어긋난다. 실측: `deposit oxide 0.2`
+  다음 `etch dry oxide 0.2` 를 하면 식각선이 증착 직전의 옛 격자 행으로 거의
+  정확히 되돌아오는데, 기울기 2.5 도 구간에서 0.19 nm 어긋난다. 그 결과 같은
+  격자 행의 점들이 선에서 0.098 nm 와 0.107 nm 로 갈려 하나는 "면 위", 하나는
+  "완전히 바깥"으로 판정되고, 그 사이에 낀 29 nm 짜리 쐐기가 통째로 남았다
+  (필드 산화막 위의 bump).
+
+  0.1 nm 조각을 살리는 것은 물리적으로 의미가 없다. 어긋남보다 한 자리 크고
+  격자 간격(수십 nm)보다는 한참 작은 1 nm 로 둔다. */
+#define ONLN_TOL 1.0e-7		/*1 nm*/
+
+static int on_poly( x, y, px, py, n )
+float x, y;
+float *px, *py;
+int n;
+{
+    int i, j;
+    double ax, ay, bx, by, dx, dy, len, t, gx, gy;
+
+    for(j = 0; j < n; j++) {
+	i = (j + 1) % n;
+	ax = px[j];  ay = py[j];  bx = px[i];  by = py[i];
+	dx = bx - ax;  dy = by - ay;
+	len = dx*dx + dy*dy;
+	if ( len <= 0.0 ) continue;
+	t = ((x - ax) * dx + (y - ay) * dy) / len;
+	if ( t < 0.0 ) t = 0.0;
+	if ( t > 1.0 ) t = 1.0;
+	gx = ax + t*dx - x;  gy = ay + t*dy - y;
+	if ( gx*gx + gy*gy < ONLN_TOL * ONLN_TOL ) return( TRUE );
+    }
+    return( FALSE );
+}
+
+
+/*-----------------TRI_QUAL---------------------------------------------
+ *  세 점이 이루는 삼각형의 품질(면적/최장변^2). 퇴화하면 0 에 가깝다.
+ *--------------------------------------------------------------------*/
+static double tri_qual( ax, ay, bx, by, cx, cy )
+double ax, ay, bx, by, cx, cy;
+{
+    double area, l1, l2, l3, lm;
+
+    area = fabs( (bx-ax)*(cy-ay) - (cx-ax)*(by-ay) ) * 0.5;
+    l1 = (bx-ax)*(bx-ax) + (by-ay)*(by-ay);
+    l2 = (cx-bx)*(cx-bx) + (cy-by)*(cy-by);
+    l3 = (ax-cx)*(ax-cx) + (ay-cy)*(ay-cy);
+    lm = (l1 > l2) ? l1 : l2;  if ( l3 > lm ) lm = l3;
+    if ( lm <= 0.0 ) return( 0.0 );
+    return( area / lm );
+}
+
+
+/*-----------------ETCH_ELEM--------------------------------------------
+ *  요소 기반 식각. etch() 와 같은 인자를 받는다.
+ *--------------------------------------------------------------------*/
+
+/*절단점이 변 끝에서 이 비율 안쪽이면 자르지 않고 그 끝점의 분류를 바꾼다.
+  자르면 그만큼 얇은 삼각형이 생기고, 얇은 삼각형이야말로 이 재작성이
+  없애려는 대상이다. 기하 오차는 그 변 길이의 5% 이하로 국한된다.*/
+/*절단을 접는 기준은 **절대거리**다. 분수로 잡으면 안 된다.
+  sp_edge() 는 mv=FALSE 로 불러도 절단점이 변 끝에서 MIN_GRID_SPACE(2.5e-8 cm
+  = 0.25 nm) 안쪽이면 새 점을 만드는 대신 **기존 점을 옮긴다**(move_edge,
+  refine/sp_edge.c:63-70). move_edge 는 그 점을 공유하는 삼각형이 뒤집히는지
+  확인하지 않아, 면적이 음수인 삼각형이 생기고 do_geom 이 죽는다.
+  그래서 접는 조건을 "sp_edge 가 점을 옮기지 않을 조건"과 정확히 맞춘다.
+  여유로 2 배를 준다. 짧은 변에서도 성립하므로 분수 기준과 달리 빠지는 곳이
+  없고, 기하 오차는 0.5 nm 로 고정된다(실리콘 격자상수 정도).*/
+#define SNAP_DIST (4.0 * 2.5e-8)
+
+/*하한을 0.3 nm 에서 1.0 nm 로 올렸다. 실측: 52 단계 흐름의 step 41 에서
+  식각선이 한 꼭짓점 옆 0.35~0.57 nm 를 지나며 그 꼭짓점에 붙은 변 네 개를
+  모두 잘랐고, 0.8 nm 안에 절단점 네 개가 몰려 변 길이 0.08 nm 인 삼각형이
+  생겼다. 여기서는 상대 기준이 듣지 않는다 — 그 변들이 3.5~6.7 nm 로 짧아
+  2% 가 0.07~0.13 nm 밖에 안 된다. 절대 하한만이 막을 수 있다.
+  값의 근거: 식각은 **받은 격자보다 고운 구조를 만들면 안 된다**. 그 입력
+  격자의 최단변이 0.577 nm 였으므로 하한은 그보다 커야 하고, 여유를 둬
+  1.0 nm 로 잡았다. 실리콘 격자상수(0.543 nm)의 두 배쯤이라 공정 시뮬레이터가
+  의미를 부여할 수 있는 최소 길이이기도 하다. 기하 오차는 1.0 nm 로 묶인다.*/
+
+/*절대거리만으로는 부족하다. 실측: 격자 40~70 nm 인 곳에서 절단이 변 끝에서
+  1.0~1.6% 지점에 찍혀 변 길이 0.5 nm 짜리 삼각형이 생겼다. 형상은 멀쩡해서
+  (품질 0.27) QUAL_MIN 에도 걸리지 않는다. 문제는 모양이 아니라 **크기**다 —
+  주변 격자보다 100 배 작은 삼각형은 뒤이은 산화가 노드를 움직이는 순간
+  뒤집혀 ck_clock 이 죽는다(41 단계 흐름의 screen oxidation 에서 실측).
+  그래서 국소 격자에 비례한 기준을 함께 둔다. 같은 실측에서 병적인 절단은
+  전부 1.6% 이하, 정상 절단은 전부 5.6% 이상이라 그 사이가 비어 있다.
+  2% 는 그 빈 구간에 놓은 값이고, 기하 오차는 변 길이의 2%(위 사례에서
+  최대 1.4 nm)로 묶인다.*/
+#define SNAP_FRAC 0.02
+#define SNAP_OF(elen) ( (SNAP_FRAC*(elen) > SNAP_DIST) ? SNAP_FRAC*(elen) : SNAP_DIST )
+
+/*한 삼각형의 두 변을 같은 꼭짓점 근처에서 자르면 그 모서리 조각이 퇴화한다.
+  길이 비율로는 못 잡는다 — 그 꼭짓점에서 두 변이 거의 일직선이면 비율이
+  넉넉해도 면적이 0 이 된다. 실측한 사망 사례: 변 길이 약 4 nm 인데 세 점이
+  공선이라 면적이 걸맞은 값의 1e-5 배, 부호가 음수가 되어
+  "triangles are not clock wise" 로 죽었다. 그래서 **실제 면적**으로 잰다.*/
+/*삼각형 품질 = 면적 / 최장변^2. 정삼각형이 0.43, 건강한 격자가 0.1~0.4,
+  퇴화한 것은 0 에 수렴한다. 실측한 사망 사례는 1.9e-6 이었다.
+  **면적 비율이 아니라 이 값으로 재는 이유**: 부모 삼각형이 이미 납작하면
+  비율 기준은 통과해 버린다(실제로 "triangle is flat" 으로 죽었다).*/
+#define QUAL_MIN 1.0e-3
+
+/*자르고 나서 이보다 납작한 삼각형은 걷어낸다. 정삼각형이 0.43 이므로 0.05 는
+  "많이 찌그러졌다" 수준이다. 예방이 아니라 사후 제거라 정확도를 깎지 않는다 —
+  접는 변이 애초에 슬라이버의 짧은 변이라 점이 움직이는 거리가 그만큼 작다.*/
+#define COLLAPSE_QUAL 0.05
+
+static int etch_elem_pass( p, nump, mater )
+float *p[MAXDIM+1];
+int nump;
+int mater;
+{
+    char *gone, *onln, *doreg;
+    struct cut_str *cut;
+    int ncut, maxcut, nsnap;
+    int *dead, ndead, nrem, *ctab;
+    int r, t, e, i, ip, gsize, pass;
+    int pin, pout;
+    double tt;
+    float c[MAXDIM];
+    int hit;
+
+    if ( nump < 2 ) return( 0 );
+
+    doreg = salloc( char, nreg );
+    for(r = 0; r < nreg; r++)
+	doreg[r] = ( ((mater == -1) || (mat_reg(r) == mater))
+		     && ask( reg[r], EXPOS ) ) ? 1 : 0;
+
+    /*이 패스에서 **새로** 다룰 영역이 없으면 아무것도 하지 않고 끝낸다.
+      지울 것이 없어도 패스를 돌면 절단 단계가 새 점을 찍어 격자를 흔든다 —
+      실측: 52 단계 흐름에서 더 깎인 재료가 한 단계도 없는데 점이 5 개 늘었고,
