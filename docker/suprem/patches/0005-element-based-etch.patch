+    for(r = 0; r < nreg; r++) clr( reg[r], ETCHED );
+
+    for(pass = 0; pass < MAX_ETCH_PASS; pass++)
+	if ( etch_elem_pass( p, nump, mater ) == 0 ) break;
+}
