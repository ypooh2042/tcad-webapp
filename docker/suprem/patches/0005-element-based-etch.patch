+
+	    for(k = 0; k < nfe; k++)
+	      for(m = k+1; m < nfe; m++) {
+		vv = -1;
+		if ( (pt_edg(fe[m],0) == pt_edg(fe[k],0)) ||
+		     (pt_edg(fe[m],0) == pt_edg(fe[k],1)) ) vv = pt_edg(fe[m],0);
+		else if ( (pt_edg(fe[m],1) == pt_edg(fe[k],0)) ||
+			  (pt_edg(fe[m],1) == pt_edg(fe[k],1)) ) vv = pt_edg(fe[m],1);
