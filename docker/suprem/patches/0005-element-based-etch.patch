+    /*--- 4 단계: 형상만 보고 다시 분류한다 ---
+      번호가 바뀌었으므로 처음부터 구한다. 식각 경계 위의 점(절단점)은
+      따로 표시한다 — 그 점들은 남기지만, "안쪽 꼭짓점이 하나라도 있고
+      바깥 꼭짓점이 없는" 삼각형을 지울 때 안쪽 편으로 세어야 한다. */
+    gone = salloc( char, np );
+    onln = salloc( char, np );
+    for(i = 0; i < np; i++) {
+	onln[i] = on_poly( cordinate(i,0), cordinate(i,1), p[0], p[1], nump ) ? 1 : 0;
+	gone[i] = ( !onln[i] &&
