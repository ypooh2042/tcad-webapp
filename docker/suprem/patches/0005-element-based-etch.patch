+    sfree(ctab);
+    sfree(cut);
+
+    /*--- 2 단계: 스냅을 반영해 자를 자리를 다시 모은다 ---*/
+    cut = salloc( struct cut_str, maxcut );
+    ncut = 0;
+    for(e = 0; e < ned && ncut < maxcut; e++) {
+	for(hit = 0, i = 0; i < num_ele_edg(e) && !hit; i++)
+	    if ( doreg[ reg_tri( ele_edg(e,i) ) ] ) hit = 1;
+	if ( !hit ) continue;
+	if ( !edge_cut( e, gone, p, nump, &pin, &pout, &tt, c ) ) continue;
+	{   double elen = hypot( (double)(cordinate(pout,0) - cordinate(pin,0)),
+				  (double)(cordinate(pout,1) - cordinate(pin,1)) );
+	    if ( (tt*elen < SNAP_OF(elen)) || ((1.0-tt)*elen < SNAP_OF(elen)) ) continue; }
+	cut[ncut].edge = e;
+	cut[ncut].c[0] = c[0];
+	cut[ncut].c[1] = c[1];
+	ncut++;
+    }
+
+    /*--- 3 단계: 자른다 ---*/
+    for(i = 0; i < ncut; i++) {
+	ip = -1;
+	(void) sp_edge( cut[i].edge, cut[i].c, &ip, FALSE );
+    }
+    sfree(cut);
+    sfree(gone);
+
+    /*자르기만 한 상태를 온전한 메시로 만든다. 여기서 점 번호가 바뀐다.*/
+    if ( ncut > 0 ) bd_connect("after etch cut");
