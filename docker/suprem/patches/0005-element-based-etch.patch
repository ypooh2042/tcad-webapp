+	    이루는 각에 따라 면적이 정해지므로 길이 비율로는 못 잡는다.
+	    실제 형상 품질(면적/최장변^2)로 잰다(QUAL_MIN).
+
+      **되풀이한다.** 스냅은 분류를 바꾸고, 분류가 바뀌면 어느 변이 잘리는지가
+      바뀐다. 한 번만 돌면 새로 생긴 퇴화를 놓친다. 스냅이 더 안 나올 때까지
+      돌리되, 분류는 한 방향으로만 움직이므로(안↔밖을 오가지 않는다) 상한을
+      둔다.
+     ---------------------------------------------------------------*/
+    nsnap = 0;
+    ctab = salloc( int, ned );
+    cut  = salloc( struct cut_str, maxcut );
+
+    for(pass = 0; pass < 8; pass++) {
+	int made = 0;
+
+	for(e = 0; e < ned; e++) ctab[e] = -1;
+	ncut = 0;
+	for(e = 0; e < ned && ncut < maxcut; e++) {
+	    for(hit = 0, i = 0; i < num_ele_edg(e) && !hit; i++)
+		if ( doreg[ reg_tri( ele_edg(e,i) ) ] ) hit = 1;
+	    if ( !hit ) continue;
+	    if ( !edge_cut( e, gone, p, nump, &pin, &pout, &tt, c ) ) continue;
+	    cut[ncut].edge = e;  cut[ncut].pin = pin;  cut[ncut].pout = pout;
+	    cut[ncut].t = tt;    cut[ncut].c[0] = c[0];  cut[ncut].c[1] = c[1];
+	    ctab[e] = ncut;
+	    ncut++;
+	}
+
+	/*(a) 절단이 변 끝에서 SNAP_DIST 안쪽이면 자르지 않고 접는다*/
+	for(i = 0; i < ncut; i++) {
+	    double elen = hypot( (double)(cordinate(cut[i].pout,0) - cordinate(cut[i].pin,0)),
+				 (double)(cordinate(cut[i].pout,1) - cordinate(cut[i].pin,1)) );
+	    if ( cut[i].t * elen < SNAP_OF(elen) ) {
+		if ( gone[ cut[i].pin ] ) { gone[ cut[i].pin ] = 0; made++; }
+	    }
+	    else if ( (1.0 - cut[i].t) * elen < SNAP_OF(elen) ) {
+		if ( !gone[ cut[i].pout ] ) { gone[ cut[i].pout ] = 1; made++; }
+	    }
+	}
+
+	/*(b) 잘린 변이 둘 이상인 삼각형의 모든 모서리 조각을 본다.
+	  세 변이 다 잘리는 경우도 여기서 걸린다 — 앞서 그 경우를 빠뜨려
+	  flip() 이 퇴화 삼각형을 만들었다. */
+	for(t = 0; t < ne; t++) {
+	    int fe[MAXSID], nfe = 0, k, m, vv, worstv = -1;
+	    double q, worstq = 1.0e30;
+	    if ( dead_tri(t) ) continue;
+	    if ( !doreg[ reg_tri(t) ] ) continue;
+	    for(i = 0; i < num_face(t); i++) {
+		e = edg_ele(t, i);
+		if ( (e >= 0) && (e < ned) && (ctab[e] != -1) ) fe[nfe++] = e;
+	    }
