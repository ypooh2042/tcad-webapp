+    dead = salloc( int, ne );
+    ndead = 0;
+    for(t = 0; t < ne; t++) {
+	int nin = 0, nout = 0, q;
+	if ( dead_tri(t) ) continue;
+	if ( !doreg[ reg_tri(t) ] ) continue;
+	for(i = 0; i < num_vert(t); i++) {
+	    q = pt_nd( vert_tri(t,i) );
