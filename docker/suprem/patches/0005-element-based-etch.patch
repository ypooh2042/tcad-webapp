+
+	/*세 꼭짓점이 전부 식각면 위인 삼각형. 꼭짓점만 봐서는 안팎을 못 정한다.
+	  격자선과 식각 경계가 정확히 겹칠 때 생기는데(직사각형 etch 가 대표적),
+	  남겨 두면 요소 한 겹짜리 벽이 서서 표면선이 되꺾이고 다음 deposit 의
+	  ck_clock() 이 "Region has malformed boundary" 로 죽는다(실측).
+	  무게중심으로 판정한다 — 삼각형 내부의 대표점이므로 애매하지 않다. */
+	{   float cx = 0.0, cy = 0.0;
+	    for(i = 0; i < num_vert(t); i++) {
+		cx += cordinate( pt_nd(vert_tri(t,i)), 0 );
+		cy += cordinate( pt_nd(vert_tri(t,i)), 1 );
+	    }
+	    cx /= (float) num_vert(t);  cy /= (float) num_vert(t);
+	    if ( in_etch_poly( cx, cy, p[0], p[1], nump ) ) dead[ndead++] = t;
+	}
+    }
+    nrem = 0;
+    for(i = 0; i < ndead; i++)
+	if ( !dead_tri(dead[i]) ) { rem_ele( dead[i], TRUE ); nrem++; }
+
+    /*어느 삼각형도 쓰지 않는 물질 노드를 걷어낸다. mtest1 과 같은 방식으로
+      센다 — 캐시(ltri)는 이 시점에 낡아 있다. */
+    {	char *used = salloc( char, nn );
+	for(i = 0; i < nn; i++) used[i] = 0;
+	for(t = 0; t < ne; t++) {
+	    if ( dead_tri(t) ) continue;
+	    for(i = 0; i < num_vert(t); i++) used[ vert_tri(t,i) ] = 1;
+	}
+	for(i = 0; i < nn; i++) {
+	    if ( dead_nd(i) || (mat_nd(i) == GAS) ) continue;
+	    if ( !used[i] ) rem_1nd(i);
+	}
+	sfree(used);
+    }
+
+    for(r = 0; r < nreg; r++)
+	if ( doreg[r] && !dead_reg(r) && (num_tri_reg(r) == 0) ) rem_reg(r);
+
+    sfree(dead);
+    sfree(onln);
+    sfree(gone);
+    sfree(doreg);
+
+    bd_connect("after etch");
+    return( nrem );
+}
